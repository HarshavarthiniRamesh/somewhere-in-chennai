const signatureViewBox = "0 0 861 993";

// "Last updated" tracks the community list, not the build — rebuilding after a
// styling tweak shouldn't claim the directory changed. Resolved at build time,
// so it's baked into the published HTML.
const DATA_FILE = "src/data/communities.js";

function lastUpdated() {
  try {
    const run = (cmd) => execSync(cmd, {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();

    // Uncommitted edits mean the commit date is already stale — say today, so
    // a local preview doesn't claim the list is older than it is.
    if (run(`git status --porcelain -- ${DATA_FILE}`)) return new Date();

    // Otherwise: when that file was last committed.
    const iso = run(`git log -1 --format=%cI -- ${DATA_FILE}`);
    if (iso) return new Date(iso);
  } catch {
    // no git, or a shallow clone with no history for this path
  }
  try {
    // A clone resets mtime to checkout time, so this is a fallback, not a peer.
    return statSync(DATA_FILE).mtime;
  } catch {
    return new Date();
  }
}

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const updated = lastUpdated();
const updatedLabel = `${updated.getDate()} ${MONTHS[updated.getMonth()]}, ${updated.getFullYear()}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDescription} />
    <title>{siteTitle}</title>
    <meta name="theme-color" content="#3D4013" />

    <!-- Share preview: the hero as it first appears at 1200 × 630 -->
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Somewhere in Chennai" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Not home. Not work. But the secret third thing. A directory of communities and activities in Chennai." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" href="/favicon.ico?v=3" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
  </head>

  <body>
    <!-- Page art (Figma 1016:14): the flowering branch in the hero, blended
         into the page colour, and a noise grain over the whole page. Clipped
         to the page so the branch can't stretch it. -->
    <div class="page-art" aria-hidden="true">
      <img class="hero-flower" src="/art/flower.webp" alt="" width="512" height="1024" />
    </div>

    <!-- ── Header ───────────────────────────────────────── -->
    <header class="site-header">
      <div class="header-left">
        <h1 class="site-title">Not home. Not work.<br />But the secret third thing.</h1>
        <p class="site-tagline">A directory of communities and activities in Chennai.</p>
      </div>
      <nav class="header-nav" aria-label="Site navigation">
        <button class="nav-btn" id="about-btn">About</button>
        <button class="nav-btn is-solid" id="submit-btn">Submit</button>
      </nav>
    </header>

    <!-- ── Filter pills ─────────────────────────────────── -->
    <nav class="filter-bar" aria-label="Filter by category">
      {filterCategories.map((cat, i) => (
        <button
          class={`filter-btn${i === 0 ? " is-active" : ""}`}
          data-filter={cat === "All" ? "all" : cat}
        >
          {cat}
          <svg class="filter-dash" aria-hidden="true"><rect width="100%" height="100%" rx="7.5" /></svg>
        </button>
      ))}
    </nav>

    <!-- ── Community table ──────────────────────────────── -->
    <main>
      <div class="community-table">
        <div class="table-head">
          <div class="cell cell-num" aria-hidden="true"></div>
          <div class="cell cell-head-name" data-sort="name" role="button" tabindex="0">
            <svg class="cell-sort-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3v10M4 7l4-4 4 4"/></svg>
            Community
          </div>
          <div class="cell cell-description" data-sort="description" role="button" tabindex="0">
            <svg class="cell-sort-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3v10M4 7l4-4 4 4"/></svg>
            What Happens
          </div>
          <div class="cell cell-category" data-sort="category" role="button" tabindex="0">
            <svg class="cell-sort-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3v10M4 7l4-4 4 4"/></svg>
            Category
          </div>
          <div class="cell cell-entry" data-sort="entry" role="button" tabindex="0">
            <svg class="cell-sort-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3v10M4 7l4-4 4 4"/></svg>
            Entry
          </div>
          <div class="cell cell-freq" data-sort="freq" role="button" tabindex="0">
            <svg class="cell-sort-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3v10M4 7l4-4 4 4"/></svg>
            Frequency
          </div>
        </div>

        {
          communities.map((community, index) => (
            <div
              class="community-row"
              data-categories={community.categories.join(",")}
              data-link={community.link}
              role={community.link ? "link" : undefined}
              tabindex={community.link ? 0 : undefined}
            >
              <div class="cell cell-num">{String(index + 1).padStart(2, "0")}</div>
              <div class="cell cell-name">{community.name}</div>
              <div class="cell cell-description">{community.description}</div>
              <div class="cell cell-category">{community.categories.join(", ")}</div>
              <div class="cell cell-entry">{community.entry}</div>
              <div class="cell cell-freq">{community.frequency}</div>
              <div class="cell cell-meta">
                {[community.categories.join(", "), community.entry, community.frequency].join(" / ")}
              </div>
            </div>
          ))
        }
      </div>
    </main>


    <!-- ── Footer ───────────────────────────────────────── -->
    <footer class="site-footer">
      <span>Last updated {updatedLabel}</span>
      <span>
        Designed by <a
          class="footer-link"
          href="https://x.com/harshajayram"
          target="_blank"
          rel="noopener"
        >Harsha</a> + Claude Code
      </span>
    </footer>

    <!-- ── About letter ─────────────────────────────────── -->
    <!-- A folded letter that opens. <dialog>, like the submit modal: Esc is
         native and a backdrop click closes it. No close control on larger
         screens, matching the design (Figma 967:595); on a phone the letter
         fills the screen, so a close button shows there. -->
    <dialog class="letter-dialog" id="about-dialog" aria-label="About this site">
      <button type="button" class="letter-close" aria-label="Close">
        <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <div class="letter" id="about-letter">
        {letterFolds.map(([from, to], i) => (
          <div
            class={`letter-panel letter-panel-${i}`}
            style={`--f: ${from}; --g: ${to};`}
            aria-hidden={i === 0 ? undefined : "true"}
          >
            <div class="letter-face">
              <div class="letter-sheet">
                <div class="letter-photos">
                  <figure class="polaroid"><img src="/about/polaroid-1.jpg" alt={i === 0 ? "An old colonial building in Chennai, with cinema posters below" : ""} /></figure>
                  <figure class="polaroid"><img src="/about/polaroid-2.jpg" alt={i === 0 ? "A weaving workshop, hands at a wooden loom" : ""} /></figure>
                  <figure class="polaroid"><img src="/about/polaroid-3.jpg" alt={i === 0 ? "A book club, everyone holding up what they're reading" : ""} /></figure>
                </div>
                <h2 class="letter-greeting">Hey there, thanks for stopping by.</h2>
                <div class="letter-body">
                  <p>Chennai is full of communities doing interesting things - book clubs, art classes, open mics, workshops, and countless other gatherings. The challenge is that many of them aren't well known. So I was surprised when people say there’s not much to do in the city except to go to malls and cafes.</p>
                  <p>Whether you’re new to the city or simply looking to meet people who share your interests, this website will help you explore more of Chennai and find communities that are worth showing up for.</p>
                  <p>Please feel free to share your feedback :)</p>
                  <p>With love,</p>
                </div>
                <svg
                  class="letter-signature"
                  viewBox={signatureViewBox}
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  role={i === 0 ? "img" : undefined}
                  aria-label={i === 0 ? "Signed, Harsha" : undefined}
                  aria-hidden={i === 0 ? undefined : "true"}
                  set:html={signaturePaths}
                />
              </div>
            </div>
            <div class="letter-back"></div>
          </div>
        ))}
      </div>
    </dialog>

    <!-- ── Submit modal ─────────────────────────────────── -->
    <dialog class="modal" id="submit-modal">
      <h2 class="modal-title">Submit a community</h2>
      <p class="modal-subtitle">Know any cool community, or want yours to be featured?</p>
      <form id="submit-form">
        <div class="form-field">
          <label class="form-label" for="f-name">Community Name</label>
          <input class="form-input" id="f-name" name="name" type="text" placeholder="Ex: Bessy Reads" required />
        </div>
        <div class="form-field">
          <label class="form-label" for="f-desc">Description</label>
          <textarea class="form-textarea" id="f-desc" name="description" placeholder="This community is about..."></textarea>
        </div>
        <div class="form-row">
          <div class="form-field">
            <span class="form-label" id="f-entry-label">Entry</span>
            <div class="multiselect" id="entry-select">
              <button
                type="button"
                class="form-input multiselect-trigger"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-labelledby="f-entry-label"
              >
                <span class="multiselect-value is-empty">Free</span>
                <svg class="multiselect-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg>
              </button>
              <div class="multiselect-menu" role="listbox" aria-multiselectable="true" aria-labelledby="f-entry-label" hidden>
                {entryOptions.map((opt) => (
                  <button type="button" class="multiselect-option" role="option" aria-selected="false" data-value={opt}>
                    <span>{opt}</span>
                    <svg class="multiselect-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  </button>
                ))}
              </div>
              <input type="hidden" name="entry" />
            </div>
          </div>
          <div class="form-field">
            <label class="form-label" for="f-link">Social Link</label>
            <input class="form-input" id="f-link" name="social" type="text" placeholder="Ex: Bessy Reads" />
          </div>
        </div>
        <button class="form-submit" type="submit">Submit</button>
        <p class="form-status" id="form-status"></p>
      </form>
    </dialog>

    <!-- ── Interactions ─────────────────────────────────── -->
    <script>
      const SHEET_ENDPOINT = "https://script.google.com/macros/s/AKfycbybNKWYR6Hzm7su5TkBcZgv7a7tvA0tpr7jkqXlbigg6S7sgW2kPOxjSMH3PUWfuvrEog/exec";

      // Tag each row with its original position so we can reset later
      const rows = Array.from(document.querySelectorAll(".community-row"));
      rows.forEach((row, i) => { row.dataset.originalIndex = String(i); });

      // ── Shared filter/renumber ────────────────────────────
      // `animate` is only passed from a pill click (after the outgoing rows
      // have faded — see Filter pills): the rows now showing ease up 6px
      // into place over 520ms, staggered 30ms apart and capped at ten rows.
      // Sorting calls this too, and stays instant. Skipped under reduced
      // motion.
      const stillRows = window.matchMedia("(prefers-reduced-motion: reduce)");
      function applyFilter(animate = false) {
        const activeBtn = document.querySelector(".filter-btn.is-active");
        const filter = activeBtn ? activeBtn.dataset.filter : "all";
        let n = 0;
        document.querySelectorAll(".community-row").forEach((row) => {
          const cats = row.dataset.categories.split(",");
          const show = filter === "all" || cats.includes(filter);
          row.hidden = !show;
          if (show) {
            n += 1;
            row.querySelector(".cell-num").textContent = String(n).padStart(2, "0");
            if (animate && !stillRows.matches && row.animate) {
              row.animate(
                [{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }],
                { duration: 520, delay: Math.min(n - 1, 10) * 30, easing: "cubic-bezier(0.22, 0.61, 0.36, 1)", fill: "backwards" },
              );
            }
          }
        });
      }

      // ── Filter pills ──────────────────────────────────────
      // A crossfade rather than a cut: the rows on screen fade out over
      // 220ms, then the new set is swapped in and eases up (applyFilter),
      // while the table itself glides from its old height to its new one —
      // without that, everything below jumped in a single frame, which is
      // what still read as abrupt. The token drops a swap that a quicker
      // second click has overtaken.
      const FADE_OUT = 220;
      const tableBox = document.querySelector("main");
      let filterToken = 0;

      // Holding the scroll position. A shorter list makes the page shorter;
      // if it ends up shorter than where the reader is scrolled to, the
      // browser clamps the scroll and the page jumps on its own. So after a
      // swap, <main> gets a min-height that keeps the page at least as tall
      // as the current scroll plus the viewport — the footer lands at the
      // bottom of the screen and nothing moves. As the reader scrolls back
      // up, the hold shrinks with them (the footer stays at the bottom of
      // the screen) until the page's natural height takes over.
      //
      // The natural height is worked out from the table's own height rather
      // than by clearing the hold and measuring the page — clearing it would
      // let the browser clamp the scroll before there was a chance to stop it.
      const tableEl = document.querySelector(".community-table");
      let held = null;   // { main, doc }: natural heights while holding
      function releaseHold() {
        held = null;
        tableBox.style.minHeight = "";
        window.removeEventListener("scroll", relaxHold);
      }
      function relaxHold() {
        if (!held) return;
        const extra = window.scrollY + window.innerHeight - held.doc;
        if (extra <= 0) { releaseHold(); return; }
        tableBox.style.minHeight = held.main + extra + "px";
      }
      function holdScroll(scrollTop) {
        const pad = parseFloat(getComputedStyle(tableBox).paddingBottom) || 0;
        const main = tableEl.offsetHeight + pad;
        const doc = Math.max(
          window.innerHeight,
          document.documentElement.scrollHeight - tableBox.offsetHeight + main,
        );
        const extra = scrollTop + window.innerHeight - doc;
        window.removeEventListener("scroll", relaxHold);
        if (extra <= 0) { held = null; tableBox.style.minHeight = ""; return; }
        held = { main, doc };
        tableBox.style.minHeight = main + extra + "px";
        window.addEventListener("scroll", relaxHold, { passive: true });
      }

      function glideHeight(from) {
        const to = tableBox.offsetHeight;
        if (Math.abs(to - from) < 2 || !tableBox.animate) return;
        tableBox.getAnimations().forEach((a) => a.cancel());
        const prev = tableBox.style.overflowY;
        tableBox.style.overflowY = "clip";
        const anim = tableBox.animate(
          [{ height: from + "px" }, { height: to + "px" }],
          { duration: 480, easing: "cubic-bezier(0.25, 0.8, 0.25, 1)" },
        );
        const reset = () => { tableBox.style.overflowY = prev; };
        anim.onfinish = reset;
        anim.oncancel = reset;
      }
      // On a phone the pills are one sideways-scrolling row; a tapped pill
      // that's partly off screen slides fully into view. Only the row
      // scrolls, never the page (scrollIntoView would move both).
      const filterBar = document.querySelector(".filter-bar");
      function revealPill(btn) {
        if (filterBar.scrollWidth <= filterBar.clientWidth) return;
        const bar = filterBar.getBoundingClientRect();
        const r = btn.getBoundingClientRect();
        const pad = parseFloat(getComputedStyle(filterBar).scrollPaddingInlineStart) || 0;
        const behavior = stillRows.matches ? "auto" : "smooth";
        if (r.left < bar.left + pad) filterBar.scrollBy({ left: r.left - bar.left - pad, behavior });
        else if (r.right > bar.right - pad) filterBar.scrollBy({ left: r.right - bar.right + pad, behavior });
      }
      document.querySelectorAll(".filter-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (btn.classList.contains("is-active")) return;
          document.querySelectorAll(".filter-btn").forEach((b) => b.classList.remove("is-active"));
          btn.classList.add("is-active");
          revealPill(btn);
          const token = ++filterToken;
          const showing = [...document.querySelectorAll(".community-row:not([hidden])")];
          if (stillRows.matches || !showing.length || !showing[0].animate) {
            const scrollTop = window.scrollY;
            tableBox.style.minHeight = tableBox.offsetHeight + "px";
            applyFilter(true);
            holdScroll(scrollTop);
            return;
          }
          showing.forEach((row) => {
            row.getAnimations().forEach((a) => a.cancel());
            row.animate([{ opacity: 1 }, { opacity: 0 }], { duration: FADE_OUT, easing: "cubic-bezier(0.4, 0, 0.6, 1)", fill: "forwards" });
          });
          setTimeout(() => {
            if (token !== filterToken) return;
            const from = tableBox.offsetHeight;
            const scrollTop = window.scrollY;
            // Pin the current height through the swap so the browser has
            // nothing to clamp, then keep only as much as the scroll needs.
            tableBox.style.minHeight = from + "px";
            showing.forEach((row) => row.getAnimations().forEach((a) => a.cancel()));
            applyFilter(true);
            holdScroll(scrollTop);
            glideHeight(from);
          }, FADE_OUT);
        });
      });

      // ── Column sort ───────────────────────────────────────
      const SORT_CELL = {
        name:        ".cell-name",
        description: ".cell-description",
        category:    ".cell-category",
        entry:       ".cell-entry",
        freq:        ".cell-freq",
      };

      const ARROW_UP   = "M8 3v10M4 7l4-4 4 4";
      const ARROW_DOWN = "M8 3v10M4 9l4 4 4-4";

      let sortCol = null;
      let sortDir = "asc";

      document.querySelectorAll(".table-head .cell[data-sort]").forEach((header) => {
        header.addEventListener("click", () => {
          const col = header.dataset.sort;

          if (sortCol === col) {
            sortDir = sortDir === "asc" ? "desc" : "asc";
          } else {
            sortCol = col;
            sortDir = "asc";
          }

          // Reset all headers, then mark the active one
          document.querySelectorAll(".table-head .cell[data-sort]").forEach((h) => {
            h.classList.remove("is-sorted-asc", "is-sorted-desc");
            h.querySelector(".cell-sort-icon path").setAttribute("d", ARROW_UP);
          });
          header.classList.add(sortDir === "asc" ? "is-sorted-asc" : "is-sorted-desc");
          header.querySelector(".cell-sort-icon path").setAttribute("d", sortDir === "asc" ? ARROW_UP : ARROW_DOWN);

          // Reorder rows
          const allRows = Array.from(document.querySelectorAll(".community-row"));
          const sel = SORT_CELL[sortCol];
          allRows.sort((a, b) => {
            const av = a.querySelector(sel).textContent.trim().toLowerCase();
            const bv = b.querySelector(sel).textContent.trim().toLowerCase();
            const cmp = av.localeCompare(bv);
            return sortDir === "asc" ? cmp : -cmp;
          });
          const parent = allRows[0].parentNode;
          allRows.forEach((row) => parent.appendChild(row));

          applyFilter();
        });
        // Headers are divs (they're grid cells), so give them a button's keys
        header.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            header.click();
          }
        });
      });

      // ── Row click → link ──────────────────────────────────
      rows.forEach((row) => {
        const go = () => {
          const link = row.dataset.link;
          if (link) window.open(link, "_blank", "noopener");
        };
        row.addEventListener("click", go);
        row.addEventListener("keydown", (e) => { if (e.key === "Enter") go(); });
      });

      // ── About letter ──────────────────────────────────────
      // The panels are fixed slices of the sheet, so they need its height.
      // That's A4 — width × √2 — unless the copy runs longer than that (a
      // narrow phone), in which case the sheet grows to fit. Measured off the
      // first panel's copy, which is laid out at natural height, and written
      // to --sheet-h. Measured on open (it's display:none before that) and on
      // resize while open.
      const A4 = Math.SQRT2;
      const aboutDialog = document.getElementById("about-dialog");
      const aboutLetter = document.getElementById("about-letter");
      const sheetProbe = aboutLetter.querySelector(".letter-sheet");
      const sizeLetter = () => {
        const h = Math.max(aboutLetter.offsetWidth * A4, sheetProbe.offsetHeight);
        aboutLetter.style.setProperty("--sheet-h", Math.round(h) + "px");
      };
      // Without hover (a phone), tapping the photos fans them out and back,
      // which hover does elsewhere. All three copies follow, so the stack
      // stays consistent across panels.
      const letterPhotos = aboutLetter.querySelectorAll(".letter-photos");
      letterPhotos.forEach((group) => group.addEventListener("click", () => {
        const spread = !group.classList.contains("is-spread");
        letterPhotos.forEach((g) => g.classList.toggle("is-spread", spread));
      }));
      document.getElementById("about-btn").addEventListener("click", () => {
        letterPhotos.forEach((g) => g.classList.remove("is-spread"));
        aboutDialog.showModal();
        aboutDialog.scrollTop = 0;
        sizeLetter();
      });
      window.addEventListener("resize", () => { if (aboutDialog.open) sizeLetter(); });

      // Closing is shared with the submit modal — see "Dialog close" below.

      // ── Submit modal ──────────────────────────────────────
      const submitModal = document.getElementById("submit-modal");
      document.getElementById("submit-btn").addEventListener("click", () => submitModal.showModal());

      // ── Dialog close ──────────────────────────────────────
      // Esc and a click on the backdrop (the dialog element itself) dismiss
      // both dialogs; the letter also has a close button on phones. A <dialog> closes
      // instantly, so both ways out are intercepted — Esc is its "cancel"
      // event — and .is-closing plays a short fade on the dialog and its
      // scrim; the real close() runs when that ends. The timeout is a
      // backstop in case animationend never arrives (a hidden tab, say).
      const stillDialogs = window.matchMedia("(prefers-reduced-motion: reduce)");
      function closeAnimated(dialog) {
        if (!dialog.open || dialog.classList.contains("is-closing")) return;
        if (stillDialogs.matches) { dialog.close(); return; }
        dialog.classList.add("is-closing");
        let done = false;
        const finish = () => {
          if (done) return;
          done = true;
          dialog.classList.remove("is-closing");
          dialog.close();
        };
        dialog.addEventListener("animationend", function onEnd(e) {
          if (e.target !== dialog || e.animationName !== "dialog-out") return;
          dialog.removeEventListener("animationend", onEnd);
          finish();
        });
        setTimeout(finish, 400);
      }
      document.querySelectorAll("dialog.modal, dialog.letter-dialog").forEach((dialog) => {
        dialog.addEventListener("click", (e) => { if (e.target === dialog) closeAnimated(dialog); });
        dialog.querySelector(".letter-close")?.addEventListener("click", () => closeAnimated(dialog));
        dialog.addEventListener("cancel", (e) => { e.preventDefault(); closeAnimated(dialog); });
      });

      // ── Entry multiselect ─────────────────────────────────
      // A listbox, not a native <select multiple>: that can't render
      // "Paid, Invite only" on one line and looks nothing like the other
      // fields. The hidden input carries the joined value into the form.
      //
      // No Escape-to-close handler — writing one tripped a false positive in
      // the secrets scanner (it read the DOM property as a ".key" file), and
      // Harsha asked me to leave that rule alone rather than reword around it.
      // Clicking outside closes the panel; Escape still closes the dialog.
      const entrySelect = document.getElementById("entry-select");
      const entryTrigger = entrySelect.querySelector(".multiselect-trigger");
      const entryMenu = entrySelect.querySelector(".multiselect-menu");
      const entryValue = entrySelect.querySelector(".multiselect-value");
      const entryInput = entrySelect.querySelector("input[type=hidden]");
      const entryOpts = Array.from(entrySelect.querySelectorAll(".multiselect-option"));

      function syncEntry() {
        const picked = entryOpts
          .filter((o) => o.getAttribute("aria-selected") === "true")
          .map((o) => o.dataset.value);
        entryInput.value = picked.join(", ");
        entryValue.textContent = picked.length ? picked.join(", ") : "Free";
        entryValue.classList.toggle("is-empty", picked.length === 0);
      }

      // The menu is position: fixed to escape the dialog's scroll clipping,
      // so it has to be placed by hand against the trigger.
      function placeEntryMenu() {
        const r = entryTrigger.getBoundingClientRect();
        entryMenu.style.left = r.left + "px";
        entryMenu.style.width = r.width + "px";
        const need = entryMenu.offsetHeight;
        const room = window.innerHeight - r.bottom;
        entryMenu.style.top = (room < need + 8 && r.top > need + 8)
          ? r.top - need - 4 + "px"      // flip above when it won't fit below
          : r.bottom + 4 + "px";
      }

      function openEntry(open) {
        entryMenu.hidden = !open;
        entryTrigger.setAttribute("aria-expanded", String(open));
        entrySelect.classList.toggle("is-open", open);
        if (open) placeEntryMenu();
      }

      window.addEventListener("resize", () => {
        if (!entryMenu.hidden) placeEntryMenu();
      });

      entryTrigger.addEventListener("click", (e) => {
        e.stopPropagation();
        openEntry(entryMenu.hidden);
      });

      entryOpts.forEach((opt) => {
        opt.addEventListener("click", (e) => {
          e.stopPropagation();
          const on = opt.getAttribute("aria-selected") === "true";
          opt.setAttribute("aria-selected", String(!on));
          syncEntry();          // stays open — you pick several
        });
      });

      document.addEventListener("click", () => openEntry(false));

      submitModal.addEventListener("scroll", () => {
        if (!entryMenu.hidden) placeEntryMenu();
      }, { passive: true });

      syncEntry();

      // ── Submit form ───────────────────────────────────────
      const form = document.getElementById("submit-form");
      const status = document.getElementById("form-status");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!SHEET_ENDPOINT) {
          status.textContent = "Submissions aren't wired up yet — coming soon!";
          return;
        }
        status.textContent = "Sending...";
        try {
          const data = new FormData(form);
          await fetch(SHEET_ENDPOINT, { method: "POST", mode: "no-cors", body: data });
          status.textContent = "Thank you! I'll take a look soon.";
          form.reset();
        } catch {
          status.textContent = "Something went wrong — please try again.";
        }
      });
    </script>
  </body>
</html>
